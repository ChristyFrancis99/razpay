# Copy this file to .env and adjust as needed.
DATA_DIR=./data
MODEL_DIR=./models
REPORTS_DIR=./reports
DATABASE_URL=sqlite:///./risk_platform.db
MODEL_FILE=fraud_model.pkl
PREPROCESSOR_FILE=preprocessor.pkl
SELECTED_FEATURES_FILE=selected_features.json
METADATA_FILE=model_metadata.json
RISK_LOW_MAX=30
RISK_MEDIUM_MAX=60
RISK_HIGH_MAX=80
RANDOM_STATE=42
TEST_SIZE=0.15
VAL_SIZE=0.15
N_SELECTED_FEATURES=40
ALLOW_SYNTHETIC_FALLBACK=true
SYNTHETIC_ROWS=20000
LLM_API_KEY=
LLM_PROVIDER=
LLM_MODEL=
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:3000,http://127.0.0.1:3000
DEFAULT_ACTOR=system

# Authentication. REQUIRED outside development.
ENVIRONMENT=development
DEBUG=true
AUTH_SECRET_KEY=CHANGE_ME_TO_A_RANDOM_32_PLUS_CHARACTER_SECRET
ACCESS_TOKEN_TTL_SECONDS=3600
DEFAULT_ADMIN_USERNAME=admin
# Set this to a strong password before first startup to bootstrap the admin user.
DEFAULT_ADMIN_PASSWORD=
