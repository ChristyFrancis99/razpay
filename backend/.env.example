# Copy this file to `.env` and adjust as needed.

# --- Paths -----------------------------------------------------------------
DATA_DIR=./data
MODEL_DIR=./models
REPORTS_DIR=./reports

TRANSACTION_TRAIN_FILE=train_transaction.csv
IDENTITY_TRAIN_FILE=train_identity.csv
TRANSACTION_TEST_FILE=test_transaction.csv
IDENTITY_TEST_FILE=test_identity.csv

# --- Database ----------------------------------------------------------------
DATABASE_URL=sqlite:///./risk_platform.db
# For Postgres later:
# DATABASE_URL=postgresql+psycopg2://user:password@localhost:5432/risk_platform

# --- Model artifact filenames ------------------------------------------------
MODEL_FILE=fraud_model.pkl
PREPROCESSOR_FILE=preprocessor.pkl
SELECTED_FEATURES_FILE=selected_features.json
METADATA_FILE=model_metadata.json

# --- Risk scoring thresholds (0-100) -----------------------------------------
RISK_LOW_MAX=30
RISK_MEDIUM_MAX=60
RISK_HIGH_MAX=80

# --- Training -----------------------------------------------------------------
RANDOM_STATE=42
TEST_SIZE=0.15
VAL_SIZE=0.15
N_SELECTED_FEATURES=40

# --- Synthetic data fallback (used only if real Kaggle CSVs are absent) -----
ALLOW_SYNTHETIC_FALLBACK=true
SYNTHETIC_ROWS=20000

# --- Optional LLM for the Copilot (leave blank to use deterministic engine) -
LLM_API_KEY=
LLM_PROVIDER=
LLM_MODEL=

# --- CORS ----------------------------------------------------------------------
CORS_ORIGINS=http://localhost:3000

# --- Audit -----------------------------------------------------------------
DEFAULT_ACTOR=system
